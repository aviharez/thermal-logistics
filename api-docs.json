{"openapi":"3.1.0","info":{"title":"Glacier & Garnish - Thermal Logistics API","description":"     Professional thermal lifecycle management for high-end ice sculpture catering.\n     \n     This API manages the complete thermal lifecycle of ice installations:\n     from initial project creation through real-time melt monitoring,\n     automated installation scheduling, and critical temperature alerting.\n ","version":"1.0.0"},"servers":[{"url":"http://localhost:8080","description":"Local Development"}],"tags":[{"name":"Ice Projects","description":"CRUS operations for Ice Sculpture Projects"},{"name":"Thermal Calculations","description":"Physics-based melt rate and thermal state calculations"},{"name":"Installation Schedule","description":"Automated setup and teardown schedule generation"},{"name":"Thermal Alerts","description":"Critical temperature change alerting for active installations"}],"paths":{"/api/v1/projects/{id}":{"get":{"tags":["Ice Projects"],"summary":"Get Ice Project by ID","operationId":"getById","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IceProjectResponse"}}}}}},"put":{"tags":["Ice Projects"],"summary":"Update an Ice Project","description":"Full replacement update. All fields including cooling equipment list will be overwritten.","operationId":"update","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IceProjectRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IceProjectResponse"}}}}}},"delete":{"tags":["Ice Projects"],"summary":"Delete an Ice Project","operationId":"delete","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"No Content"}}}},"/api/v1/alerts/{alertId}/acknowledge":{"put":{"tags":["Thermal Alerts"],"summary":"Acknowledge an alert","description":"Marks an alert as reviewed by the operations team. Does not dismiss the underlying condition.","operationId":"acknowledge","parameters":[{"name":"alertId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AlertResponse"}}}}}}},"/api/v1/schedule/{projectId}/regenerate":{"post":{"tags":["Installation Schedule"],"summary":"Regenerate schedule with latest weather","description":"Forces a fresh weather fetch and recalculates the full schedule. Use this endpoint when forecast conditions have changed.","operationId":"regenerateSchedule","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InstallationSchedule"}}}}}}},"/api/v1/projects":{"get":{"tags":["Ice Projects"],"summary":"List all Ice Projects","description":"Returns all projects. Optionally filter by status using the `status` query parameter.","operationId":"getAll","parameters":[{"name":"status","in":"query","description":"Filter by project status","required":false,"schema":{"type":"string","enum":["DRAFT","SCHEDULED","ACTIVE","COMPLETED","CANCELLED"]}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/IceProjectResponse"}}}}}}},"post":{"tags":["Ice Projects"],"summary":"Create a new Ice Project","description":"Creates a new ice project with sculpture metadata, venue details, and cooling equipment.","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IceProjectRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IceProjectResponse"}}}}}}},"/api/v1/projects/{id}/equipment":{"post":{"tags":["Ice Projects"],"summary":"Add cooling equipment to a project","operationId":"addEquipment","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CoolingEquipmentRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IceProjectResponse"}}}}}}},"/api/v1/alerts/check/{projectId}":{"post":{"tags":["Thermal Alerts"],"summary":"Check and generate Critical Temperature Warnings","operationId":"checkAlerts","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AlertResponse"}}}}}}}},"/api/v1/projects/{id}/status":{"patch":{"tags":["Ice Projects"],"summary":"Update project status","description":"Transitions the project through its lifecycle: DRAFT -> SCHEDULED -> ACTIVE -> COMPLETED.","operationId":"updateStatus","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"status","in":"query","description":"New project status","required":true,"schema":{"type":"string","enum":["DRAFT","SCHEDULED","ACTIVE","COMPLETED","CANCELLED"]}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IceProjectResponse"}}}}}}},"/api/v1/thermal/{projectId}/melt-rate":{"get":{"tags":["Thermal Calculations"],"summary":"Get current melt rate","description":"Returns only the melt rate in kg/hour with the effective temperature for a quick status check.","operationId":"getMeltRate","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/MeltRateSummary"}}}}}}},"/api/v1/thermal/{projectId}/calculate":{"get":{"tags":["Thermal Calculations"],"summary":"Calculate thermal state for a project","description":"    Fetches live weather data for the project's venue location and computes the full thermal\n    state including: effective temperature, melt rate (kg/h), time to structural failure,\n    peak clarity window, and whether the event duration fits within the safe display window.\n","operationId":"calculate","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ThermalCalculationResult"}}}}}}},"/api/v1/thermal/{projectId}/calculate/override":{"get":{"tags":["Thermal Calculations"],"summary":"Calculate thermal state with a manual temperature override","description":"Run the melt calculation with a custom ambient temperature. Useful for planning worst-case scenarios or heat-wave contingencies","operationId":"calculateWithOverride","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"temperatureCelsius","in":"query","description":"Override ambient temperature in C","required":true,"schema":{"type":"number","format":"double"},"example":32.5}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ThermalCalculationResult"}}}}}}},"/api/v1/schedule/{projectId}":{"get":{"tags":["Installation Schedule"],"summary":"Generate installation schedule","operationId":"getSchedule","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/InstallationSchedule"}}}}}}},"/api/v1/alerts":{"get":{"tags":["Thermal Alerts"],"summary":"List all alerts","description":"Returns all thermal alerts across all projects.","operationId":"getAllAlerts","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AlertResponse"}}}}}}}},"/api/v1/alerts/{alertId}":{"get":{"tags":["Thermal Alerts"],"summary":"Get alert by ID","operationId":"getAlert","parameters":[{"name":"alertId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AlertResponse"}}}}}}},"/api/v1/alerts/unacknowledged":{"get":{"tags":["Thermal Alerts"],"summary":"List all unacknowledged alerts","description":"Returns all alerts that have not yet been acknowledged by the operations team.","operationId":"getUnacknowledged","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AlertResponse"}}}}}}}},"/api/v1/alerts/project/{projectId}":{"get":{"tags":["Thermal Alerts"],"summary":"Get all alerts for a project","operationId":"getAlertsByProject","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AlertResponse"}}}}}}}},"/api/v1/alerts/project/{projectId}/recent":{"get":{"tags":["Thermal Alerts"],"summary":"Get alerts triggered in the last 24 hours for a project","operationId":"getRecentAlerts","parameters":[{"name":"projectId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AlertResponse"}}}}}}}},"/api/v1/projects/{id}/equipment/{equipmentId}":{"delete":{"tags":["Ice Projects"],"summary":"Remove cooling equipment from a project","operationId":"removeEquipment","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"equipmentId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/IceProjectResponse"}}}}}}}},"components":{"schemas":{"CoolingEquipmentRequest":{"type":"object","description":"Cooling equipment unit for an Ice Project","properties":{"equipmentType":{"type":"string","description":"Type of cooling equipment","enum":["FAN","DRY_ICE_BOOSTER","DRIP_TRAY"],"example":"FAN"},"quantity":{"type":"integer","format":"int32","description":"Number of units deployed","example":2,"maximum":20,"minimum":1}},"required":["equipmentType","quantity"]},"IceProjectRequest":{"type":"object","description":"Request payload for creating or updating an Ice Project","properties":{"name":{"type":"string","description":"Display name for the ice project","example":"Gala Neptune Centerpiece","maxLength":120,"minLength":0},"description":{"type":"string","description":"Additional project notes","example":"VIP table installation for annual charity gala","maxLength":500,"minLength":0},"latitude":{"type":"number","format":"double","description":"Venue latitude for weather lookup","example":51.5074,"maximum":90.0,"minimum":-90.0},"longitude":{"type":"number","format":"double","description":"Venue longitude for weather lookup","example":-0.1278,"maximum":180.0,"minimum":-180.0},"venueName":{"type":"string","description":"Name of the event venue","example":"The Savoy Grand Ballroom","maxLength":200,"minLength":0},"venueType":{"type":"string","description":"Venue climate classification","enum":["OUTDOOR","INDOOR_UNCOOLED","INDOOR_COOLED"],"example":"INDOOR_COOLED"},"indoorCoolingOffset":{"type":"number","format":"double","description":"Venue air conditioning temperature reduction in C (overrides venue type default)","example":8.0,"maximum":20.0,"minimum":0.0},"iceType":{"type":"string","description":"Type of ice sculpture material","enum":["CLEAR","WHITE"],"example":"CLEAR"},"sculptureVolumeLiters":{"type":"number","format":"double","description":"Total sculpture volume in liters","example":250.0,"maximum":10000.0,"minimum":1.0},"eventStartTime":{"type":"string","format":"date-time","description":"Event start date and time (ISO-8601)","example":"2026-08-15T18:00:00"},"eventEndTime":{"type":"string","format":"date-time","description":"Event end date and time (ISO-8601)","example":"2026-08-15T23:00:00"},"coolingEquipments":{"type":"array","description":"Cooling equipment inventory for this project","items":{"$ref":"#/components/schemas/CoolingEquipmentRequest"}}},"required":["eventEndTime","eventStartTime","iceType","indoorCoolingOffset","latitude","longitude","sculptureVolumeLiters","venueType"]},"CoolingEquipmentResponse":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"equipmentType":{"type":"string"},"equipmentDisplayName":{"type":"string"},"quantity":{"type":"integer","format":"int32"},"totalTemperatureReductionCelsius":{"type":"number","format":"double"}}},"IceProjectResponse":{"type":"object","description":"Complete Ice Project response payload","properties":{"id":{"type":"integer","format":"int64","description":"Unique project identifier"},"name":{"type":"string"},"description":{"type":"string"},"latitude":{"type":"number","format":"double"},"longitude":{"type":"number","format":"double"},"venueName":{"type":"string"},"venueType":{"type":"string","enum":["OUTDOOR","INDOOR_UNCOOLED","INDOOR_COOLED"]},"indoorCoolingOffset":{"type":"number","format":"double"},"iceType":{"type":"string","enum":["CLEAR","WHITE"]},"sculptureVolumeLiters":{"type":"number","format":"double"},"eventStartTime":{"type":"string","format":"date-time"},"eventEndTime":{"type":"string","format":"date-time"},"status":{"type":"string","enum":["DRAFT","SCHEDULED","ACTIVE","COMPLETED","CANCELLED"]},"coolingEquipments":{"type":"array","items":{"$ref":"#/components/schemas/CoolingEquipmentResponse"}},"eventDurationHours":{"type":"number","format":"double","description":"Event duration in hours"},"baselineTemperatureCelsius":{"type":"number","format":"double","description":"Baseline temperature captured on first alert check within the 24h pre-event window (C). Null until first check."},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},"AlertResponse":{"type":"object","description":"Thermal alert triggered by forecast changes","properties":{"id":{"type":"integer","format":"int64","description":"Alert identifier"},"projectId":{"type":"integer","format":"int64","description":"Associated project ID"},"projectName":{"type":"string","description":"Associated project name"},"severity":{"type":"string","description":"Alert severity level","enum":["LOW","MEDIUM","HIGH","CRITICAL"]},"message":{"type":"string","description":"Human-readable alert message"},"baselineTemperatureCelsius":{"type":"number","format":"double","description":"Temperature at time of original schedule calculation (C)"},"triggeredTemperatureCelsius":{"type":"number","format":"double","description":"Forecasted temperature that triggered the alert (C)"},"temperatureDeltaCelsius":{"type":"number","format":"double","description":"Temperature increate delta (C)"},"acknowledged":{"type":"boolean","description":"Whether this alert has been acknowledged"},"triggeredAt":{"type":"string","format":"date-time","description":"Alert creation timestamp"}}},"InstallationSchedule":{"type":"object","description":"Auto-generated installation and teardown schedule for an Ice Project","properties":{"projectId":{"type":"integer","format":"int64","description":"Project identifier"},"projectName":{"type":"string","description":"Project name"},"setupArrivalTime":{"type":"string","format":"date-time","description":"Recommended arrival and preparation time"},"recommendedInstallationTime":{"type":"string","format":"date-time","description":"Recommended sculpture installation start time"},"peakClarityStart":{"type":"string","format":"date-time","description":"Start of peak visual clarity window"},"peakClarityEnd":{"type":"string","format":"date-time","description":"End of peak visual clarity window (10% mass loss reached)"},"estimatedStructuralFailureTime":{"type":"string","format":"date-time","description":"Estimated time of structural failure under current conditions"},"mandatoryTeardownTime":{"type":"string","format":"date-time","description":"Mandatory teardown deadline (failure time minus safety buffer)"},"estimatedMeltTimeHours":{"type":"number","format":"double","description":"Total estimated melt time from installation (hours)"},"peakClarityDurationHours":{"type":"number","format":"double","description":"Peak clarity window duration (hours)"},"safeDisplayWindowHours":{"type":"number","format":"double","description":"Safe display window from installation to teardown (hours)"},"forecastTemperatureCelsius":{"type":"number","format":"double","description":"Ambient temperature used for this schedule (C)"},"effectiveTemperatureCelsius":{"type":"number","format":"double","description":"Effective temperature after all cooling adjustments (C)"},"eventFitsInSafeWindow":{"type":"boolean","description":"Whether the event fully fits within the safe display window"},"setupLeadTimeMinutes":{"type":"integer","format":"int32","description":"Setup lead time in minutes based on sculpture volume"},"recommendations":{"type":"array","description":"Operational recommendations generated by the scheduler","items":{"type":"string"}},"weatherSummary":{"type":"string","description":"Weather summary for the event period"},"generatedAt":{"type":"string","format":"date-time","description":"Schedule generated at"}}},"MeltRateSummary":{"type":"object","properties":{"projectId":{"type":"integer","format":"int64"},"projectName":{"type":"string"},"ambientTemperatureCelsius":{"type":"number","format":"double"},"effectiveTemperatureCelsius":{"type":"number","format":"double"},"meltRateKgPerHour":{"type":"number","format":"double"},"iceType":{"type":"string"}}},"ThermalCalculationResult":{"type":"object","description":"Thermal melt calculation result for an Ice Project","properties":{"projectId":{"type":"integer","format":"int64","description":"Project identifier"},"projectName":{"type":"string","description":"Project name"},"ambientTemperatureCelsius":{"type":"number","format":"double","description":"Raw ambient temperature from weather data (C)"},"effectiveTemperatureCelsius":{"type":"number","format":"double","description":"Effective temperature after all cooling adjustment (C)"},"surfaceAreaM2":{"type":"number","format":"double","description":"Estimated surface area of the sculpture (m2)"},"initialMassKg":{"type":"number","format":"double","description":"Initial ice mass (kg)"},"meltRateKgPerHour":{"type":"number","format":"double","description":"Current melt rate (kg/hour)"},"totalMeltTimeHours":{"type":"number","format":"double","description":"Total estimated time until fully melted (hours)"},"timeToStructuralFailureHours":{"type":"number","format":"double","description":"Time until structural integrity is compromised at 40% mass loss (hours)"},"peakClarityWindowHours":{"type":"number","format":"double","description":"Duration of the peak visual clarity window (hours)"},"safeDisplayWindowHours":{"type":"number","format":"double","description":"Safe display window, time before mandatory removal (hours)"},"coolingBreakdown":{"type":"object","additionalProperties":{"type":"number","format":"double"},"description":"Breakdown of cooling contributions by source (C reduction per source)"},"weatherDescription":{"type":"string","description":"Weather condition summary"},"calculatedAt":{"type":"string","format":"date-time","description":"Timestamp of this calculation"},"projectedFailureTime":{"type":"string","format":"date-time","description":"Projected structural failure time given current weather"},"eventExceedsSafeWindow":{"type":"boolean","description":"Whether the event duration exceeds the safe display window"}}}}}}